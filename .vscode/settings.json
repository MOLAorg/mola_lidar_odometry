{
    "C_Cpp.autoAddFileAssociations": false,
    "C_Cpp.doxygen.generateOnType": false,
    "C_Cpp.files.exclude": {
        "**/.git": true,
        "**/.vscode": true,
        "**/docs": true,
        "**/install": true,
        "**/log": true
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}/build",
        "--completion-style=detailed",
        "--header-insertion=never",
        "--pretty",
        // Tell clangd to use the project’s .clang-format file
        "--fallback-style=none"
    ],
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "editor.formatOnSave": true,
    "cSpell.allowCompoundWords": true,
    "cSpell.ignorePaths": [
        "**/.git/objects/**",
        "**/.vscode",
        "**/build/",
        "**/install/",
        "**/log/",
        ".clang-tidy"
    ],
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true
    },
    "ros.distro": "humble",
    "cSpell.words": [
        "deskewed",
        "DPDF",
        "ENTYPO",
        "liodom",
        "rebaker",
        "recolorize",
        "relocalize",
        "thres",
        "voxelmaps"
    ],
    "cSpell.ignoreWords": [
        "Boxf"
    ]
}